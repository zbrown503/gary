# Copy to .env.local for local dev. In Vercel, add these under Project → Settings → Environment Variables.
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Later milestones (server-only, never NEXT_PUBLIC_)
