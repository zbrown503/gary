# Copy to .env.local for local dev. In Vercel, add these under Project → Settings → Environment Variables.
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Later milestones (server-only, never NEXT_PUBLIC_)
# ANTHROPIC_API_KEY=
# VOYAGE_API_KEY=        # embeddings (Milestone 2)
# OPENAI_API_KEY=        # Whisper voice-to-text, if chosen (Milestone 4)
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
